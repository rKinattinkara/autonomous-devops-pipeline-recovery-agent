# GitHub credentials
# Create a fine-grained PAT at https://github.com/settings/tokens
# Required scopes: Actions (read), Contents (read/write), Pull requests (read/write), Workflows (read)
GITHUB_TOKEN=your_github_personal_access_token

# The GitHub account / org that owns the repository
GITHUB_OWNER=your_github_username

# The repository name (must match the repo where this agent will open recovery PRs)
GITHUB_REPO=your_repository_name

# OpenAI API key — used by both the RCA and Remediation agents
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Optional: Slack incoming webhook URL for recovery notifications
# Leave as-is to disable Slack notifications
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=your_slack_webhook_url
